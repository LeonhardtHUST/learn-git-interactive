{
  "name": "learn-git-interactive",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --preload @opentui/solid/preload --watch src/main.ts",
    "start": "bun run --preload @opentui/solid/preload src/main.ts",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload @opentui/solid/preload --timeout 120000",
    "test:e2e": "bun test --preload @opentui/solid/preload tests/e2e/",
    "compile": "bun run scripts/build.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "solid-js": "^1.9.14",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
