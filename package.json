{
  "name": "learn-git-interactive",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun test",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 120000",
    "test:e2e": "bun test tests/e2e/",
    "compile": "bun build ./src/main.ts --outdir ./dist --target bun"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "solid-js": "^1.9.14",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
